+def fuse_candidates(semantic, lexical, threshold):
+    """Reciprocal rank fusion; keyword scores are not semantic probabilities."""
+    by_id, scores = {}, {}
+    for candidates in (semantic, lexical):
+        seen = set()
+        for rank, row in enumerate(candidates, 1):
+            key = row['id']
+            if key in seen or float(row['similarity']) < threshold:
+                continue
+            seen.add(key)
+            by_id.setdefault(key, row)
+            scores[key] = scores.get(key, 0) + 1/(60+rank)
+    return [by_id[key] for key in sorted(scores, key=lambda key: -scores[key])]
 
 
