+# Keep source IDs only, not raw questions, answers or document content.
+# Re-fetch active rows before reuse; do not treat chat history as factual evidence.
+_evidence_lock = threading.Lock()
+_evidence_ids = OrderedDict()
+
+def recent_evidence(session_id, generation_id, source_ids=None):
+    now = time.monotonic()
+    key = (session_id, generation_id)
+    with _evidence_lock:
+        for old_key, (updated, _) in list(_evidence_ids.items()):
+            if now-updated > 1800:
+                del _evidence_ids[old_key]
+        if source_ids is not None:
+            _evidence_ids[key] = (now, tuple(source_ids[:5]))
+            _evidence_ids.move_to_end(key)
+            while len(_evidence_ids)>128:
+                _evidence_ids.popitem(last=False)
+        return _evidence_ids.get(key, (now, ()))[1]
 
 
