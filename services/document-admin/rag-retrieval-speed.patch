 def words(text):
     return [w for w in re.findall(r'[^\W_]+', text.casefold()) if len(w) >= 3 and w not in STOP][:20]
+
+
+@lru_cache(maxsize=512)
+def chunk_vocabulary(content):
+    return frozenset(w for w in re.findall(r'[^\W_]+', content.casefold()) if len(w) >= 3) | frozenset(words(content))
+
+
+def best_similarity(token, vocabulary):
+    if token in vocabulary:
+        return 1.0
+    best = 0.0
+    for word in vocabulary:
+        # Length and quick_ratio are upper bounds: pruning preserves exact ranks.
+        if 2 * min(len(token), len(word)) / (len(token) + len(word)) <= best:
+            continue
+        matcher = SequenceMatcher(None, token, word)
+        if matcher.quick_ratio() > best:
+            best = max(best, matcher.ratio())
+    return best
 
 
